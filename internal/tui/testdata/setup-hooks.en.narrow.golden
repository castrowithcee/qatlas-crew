  | +    "Stop": [                                       |  
  | + {"hooks": [{"type": "command", "command":          |  
  | "/opt/qcrew hook codex", "async": true}]}            |  
  | +    ]                                               |  
  | +  }                                                 |  
  | /home/u/.codex/config.toml                           |  
  | +[hooks.state."/home/u/.codex/hooks.json:stop:0:0"]  |  
  | +trusted_hash = "sha256:72b8d41a"                    |  
