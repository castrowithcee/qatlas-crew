{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qcrew/bin/qcrew hook claude --session abcdefghij23",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
